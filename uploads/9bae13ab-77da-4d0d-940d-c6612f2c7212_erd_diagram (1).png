digraph ERD {
	rankdir=LR size=12
	User [fillcolor=lightblue shape=box style=filled]
	Survey [fillcolor=lightblue shape=box style=filled]
	Quotation [fillcolor=lightblue shape=box style=filled]
	Order [fillcolor=lightblue shape=box style=filled]
	Contract [fillcolor=lightblue shape=box style=filled]
	"Work Order" [fillcolor=lightblue shape=box style=filled]
	"Production Plan" [fillcolor=lightblue shape=box style=filled]
	"Production Step" [fillcolor=lightblue shape=box style=filled]
	Machine [fillcolor=lightblue shape=box style=filled]
	"QA Check" [fillcolor=lightblue shape=box style=filled]
	"Team Leader Review" [fillcolor=lightblue shape=box style=filled]
	User -> Survey [label="Customer submits"]
	Survey -> Quotation [label="Survey generates"]
	User -> Quotation [label="Sale Staff creates"]
	User -> Quotation [label="Sale Manager reviews"]
	Quotation -> Order [label="Customer confirms"]
	Order -> Contract [label="Order has contract"]
	User -> Contract [label="Sale Manager approves"]
	Contract -> "Work Order" [label="Contract creates"]
	User -> "Work Order" [label="Sale Staff assigns"]
	User -> "Work Order" [label="Tech Department handles"]
	"Work Order" -> "Production Plan" [label="Creates plan"]
	User -> "Production Plan" [label="Tech Department makes"]
	"Production Plan" -> "Production Step" [label="Includes steps"]
	"Production Step" -> Machine [label="Uses machine"]
	"Production Plan" -> "QA Check" [label="QA checks"]
	User -> "QA Check" [label="QA Staff reviews"]
	"Production Plan" -> "Team Leader Review" [label="Reviewed by Team Leader"]
	User -> "Team Leader Review" [label="Team Leader evaluates"]
}
